# 通用配置 
SPRING_PROFILES_ACTIVE=prod

# 数据库模式（single | dual）
DATABASE_MODE=dual

# 主数据库配置 
PRIMARY_DB_URL=jdbc:mariadb://mariadb-primary:3306/novel?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&connectTimeout=30000&socketTimeout=60000
PRIMARY_DB_USERNAME=novel_user
PRIMARY_DB_PASSWORD=novel_password
PRIMARY_DB_POOL_SIZE=15
PRIMARY_DB_MIN_IDLE=5

# 从数据库配置 
SECONDARY_DB_URL=jdbc:mariadb://mariadb-secondary:3306/novel?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&connectTimeout=30000&socketTimeout=60000
SECONDARY_DB_USERNAME=novel_user
SECONDARY_DB_PASSWORD=novel_password
SECONDARY_DB_POOL_SIZE=8
SECONDARY_DB_MIN_IDLE=3

# 应用配置 
SERVER_PORT=8081
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:8080
SITEMAP_RUN=false

# 代理配置 (可选) 
PROXY_HOST=
PROXY_PORT=7897
PROXY_CLIENT=false
